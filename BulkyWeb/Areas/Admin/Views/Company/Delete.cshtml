@* @using Bulky.Models *@
@model Product


<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Delete Category</h2>
            <hr />
        </div>
        <input type="hidden" asp-for="Id"/>
        <div asp-validation-summary="All"></div>
        <div class="mb-3 row p-1">
            <label asp-for="Title">Title</label>
            <input asp-for="Title" disabled type="text" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label asp-for="Description">Description</label>
            <input asp-for="Description" disabled type="text" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label asp-for="ISBN">ISBN</label>
            <input asp-for="ISBN" type="text" disabled class="form-control" />
            <span asp-validation-for="ISBN" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label asp-for="Author">Author</label>
            <input asp-for="Author" disabled type="text" class="form-control" />
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label asp-for="ListPrice">ListPrice</label>
            <input asp-for="ListPrice" disabled type="text" class="form-control" />
            <span asp-validation-for="ListPrice" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label asp-for="Price">Price</label>
            <input asp-for="Price" disabled type="text" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label asp-for="Price50">Price 50</label>
            <input asp-for="Price50" disabled type="text" class="form-control" />
            <span asp-validation-for="Price50" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label asp-for="Price100">Price 100</label>
            <input asp-for="Price100" disabled type="text" class="form-control" />
            <span asp-validation-for="Price100" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-danger form-control">Delete</button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Product" asp-action="Index" class="btn btn-secondary border form-control">
                    <i class="bi bi-cart4"></i> Back2List
                </a>
            </div>
        </div>
    </div>
</form>